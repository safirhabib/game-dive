# Backend API URL (used by frontend at build time). No trailing slash.
# Development: leave unset to use http://localhost:5001/api/v1
# Production: set to your API origin, e.g. https://api.yourdomain.com/api/v1
# VITE_API_URL=https://api.yourdomain.com/api/v1

# PayPal client ID (frontend SDK; same as backend PAYPAL_CLIENT_ID)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# Support email shown in footer, delivery status, and How It Works
# VITE_SUPPORT_EMAIL=support@yourdomain.com
