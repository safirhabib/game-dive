# Server Configuration
NODE_ENV=development
PORT=5001
NODE_OPTIONS=--max_old_space_size=4096

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/gamecastledb

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# File Upload
MAX_FILE_UPLOAD=5000000 # 5MB
FILE_UPLOAD_PATH=./public/uploads

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@gamecastlebd.com
FROM_NAME=Game Castle BD

# Rate Limiting
RATE_LIMIT_WINDOW_MS=10 * 60 * 1000 # 10 minutes
RATE_LIMIT_MAX=100

# CORS (comma-separated for multiple; must include FRONTEND_URL in production)
CORS_ORIGIN=http://localhost:5173

# API Documentation
NODE_ENV=development

# Exchange Rate API (Optional)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Frontend URL (for Stripe redirects and CORS). Use production URL when deploying.
FRONTEND_URL=http://localhost:5173

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret_key
# Optional: for webhook signature verification (from PayPal Developer Dashboard > Webhooks)
# PAYPAL_WEBHOOK_ID=your_webhook_id

# Redis Cache
# Use REDIS_URL for hosted Redis providers, or REDIS_HOST/PORT for a direct connection.
REDIS_ENABLED=true
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
