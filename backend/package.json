{
  "name": "game-dive-backend",
  "version": "1.0.0",
  "description": "Backend API for GameDive - A modern game store platform",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.+(js|json|md)\"",
    "prepare": "husky install",
    "seed": "node seed.js",
    "seed:users": "node seed.js --users",
    "seed:games": "node seed.js --games",
    "seed:all": "node seed.js --all",
    "seed:reset": "node seed.js --reset",
    "import:games": "node scripts/importGames.js",
    "import:gift-cards": "node scripts/importGiftCards.js",
    "import:in-game-points": "node scripts/importInGamePoints.js",
    "import:region-change": "node scripts/importRegionChangeProducts.js",
    "import:subscriptions": "node scripts/importSubscriptions.js",
    "import:running-offers": "node scripts/importRunningOffers.js"
  },
  "keywords": [
    "game",
    "store",
    "api",
    "mongodb",
    "express",
    "nodejs"
  ],
  "author": "GameDive Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.3",
    "redis": "^5.6.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.2",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
